# Copy to .env and fill in a REAL, freshly-rotated key. Never commit .env.
# Generate/rotate keys at https://console.anthropic.com/settings/keys

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# From your Supabase project -> Settings -> API.
SUPABASE_URL=https://evgdecewwmkupiadgfop.supabase.co

# From the SAME page — the SERVICE ROLE key, NOT the anon key. Bypasses
# Row Level Security entirely — treat it exactly like CLAUDE_API_KEY:
# server-side only, never in any frontend file, never pasted anywhere else.
SUPABASE_SERVICE_ROLE_KEY=

# Exact origin your frontend is served from, e.g. https://lastmind.co.uk
FRONTEND_ORIGIN=https://your-domain.example

PORT=4100
